---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span>© {year} {site.name}</span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-5) var(--pad);
    border-top: 1px solid var(--line);
    color: var(--fg-muted);
    font-size: var(--t-2);
    font-weight: 500;
    letter-spacing: .04em;
  }
</style>
