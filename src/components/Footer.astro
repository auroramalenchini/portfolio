---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- La ciudad va junto al nombre y no del otro lado: a la derecha la
       tapaba el botón de volver arriba. -->
  <span>© {year} {site.name}<span class="lugar">{site.location}</span></span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-5) var(--pad);
    border-top: 1px solid var(--line);
    color: var(--fg-muted);
    font-size: var(--t-2);
    font-weight: 500;
    letter-spacing: .04em;
  }
  .lugar::before { content: " · "; }
  /* En el teléfono, en un renglón aparte: seguido del nombre llegaba hasta
     el botón de volver arriba. */
  @media (max-width: 560px) {
    .lugar { display: block; margin-top: var(--s-1); }
    .lugar::before { content: none; }
  }
</style>
