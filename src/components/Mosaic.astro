---
// El mosaico justificado, sin JavaScript en el navegador. Dónde termina cada
// fila se decide al publicar (src/lib/rows.ts), por separado para pantalla
// ancha y angosta: entre fila y fila va un corte de línea que sólo se muestra
// en su pantalla. Dentro de cada fila las placas crecen en proporción a su
// forma, así que la fila llena el ancho con todas las fotos del mismo alto y
// ninguna se recorta. Ninguna fila queda suelta, tampoco la última.
import { Picture, getImage } from 'astro:assets';
import { partitionRows, rowEnds, ROW_TARGET, type MosaicLayout } from '../lib/rows';

export interface MosaicItem {
  image: ImageMetadata;
  alt: string;
  /** Lo que necesita el visor: grupo de flechas, título y bajada. */
  lb: { group: string; title: string; sub: string };
}

interface Props {
  items: MosaicItem[];
  /** Qué mosaico es: define el alto buscado de las filas (ROW_TARGET). */
  layout: MosaicLayout;
  /** El `sizes` del `<img>`: cuánto de la pantalla ocupa una placa. */
  sizes: string;
  /** Opcional: cuántas placas se ven en pantalla angosta. */
  mobileLimit?: number;
}

const { items, layout, sizes, mobileLimit } = Astro.props;

const ANCHOS = [480, 960, 1600];
const ANCHO_VISOR = 1600;

// Se sirven dos formatos: avif en <source> y jpeg en el <img> de respaldo.
// El jpeg va sólo como respaldo y no además como <source>, porque serían los
// mismos archivos dos veces: eran 70 MB y 700 conversiones al aire.

const placas = await Promise.all(
  items.map(async (item, i) => {
    const { image } = item;
    // Nunca pedimos un ancho mayor que el del archivo: agrandar no suma
    // definición, sólo bytes.
    const tope = Math.min(ANCHO_VISOR, image.width);
    const widths = [...new Set([...ANCHOS.filter((w) => w < image.width), tope])];
    // 'jpg' y no 'jpeg': es el formato del <img> de respaldo, así el visor
    // reusa el archivo que ya generó <Picture> en vez de encodear otro igual.
    const full = await getImage({ src: image, width: tope, format: 'jpg' });
    return {
      ...item,
      widths,
      ar: image.width / image.height,
      src: full.src,
      w: tope,
      h: Math.round((tope * image.height) / image.width),
      // Las dos primeras entran en la primera pantalla: van sin diferir.
      eager: i < 2,
    };
  })
);

const ratios = placas.map((p) => p.ar);
// En pantalla angosta el tope de placas deja afuera las últimas: las filas se
// arman sólo con las que se ven.
const visiblesAngosto = mobileLimit ? Math.min(mobileLimit, placas.length) : placas.length;
const cortesAncho = rowEnds(partitionRows(ratios, ROW_TARGET[layout].wide));
const cortesAngosto = rowEnds(partitionRows(ratios.slice(0, visiblesAngosto), ROW_TARGET[layout].narrow));
---

<div class="mosaic">
  {
    placas.map((placa, i) => (
      <>
        <div class:list={['card-wrap', { 'solo-ancho': i >= visiblesAngosto }]} style={`--ar: ${placa.ar}`}>
          <button
            type="button"
            class="card"
            style={`--ar: ${placa.ar}`}
            data-lb={placa.lb.group}
            data-lb-src={placa.src}
            data-lb-w={placa.w}
            data-lb-h={placa.h}
            data-lb-title={placa.lb.title}
            data-lb-sub={placa.lb.sub}
          >
            <Picture
              src={placa.image}
              widths={placa.widths}
              formats={['avif']}
              fallbackFormat="jpg"
              sizes={sizes}
              alt={placa.alt}
              loading={placa.eager ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
          {i === 0 && <slot name="play" />}
        </div>
        {(cortesAncho.has(i) || cortesAngosto.has(i)) && (
          <span
            class:list={['corte', { ancho: cortesAncho.has(i), angosto: cortesAngosto.has(i) }]}
            aria-hidden="true"
          />
        )}
      </>
    ))
  }
</div>

<style>
  /* Una sola fila por línea: las placas parten de ancho cero, así que nunca
     saltan de línea por su cuenta; sólo lo hacen en un corte. El corte ocupa
     el 100% y queda solo en una línea sin alto: por eso el espacio vertical
     va a la mitad, y entre fila y fila suman lo mismo que el horizontal. */
  .mosaic {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-2);
    row-gap: calc(var(--s-2) / 2);
    align-items: flex-start;
  }

  /* Crecer en proporción a la forma es lo que justifica la fila: el ancho se
     reparte según lo apaisada que es cada foto, así que todas terminan con el
     mismo alto. El ×1000 no es decorativo: si los factores de una fila suman
     menos de 1 (una vertical sola es 0,67), flexbox reparte sólo esa fracción
     del sobrante y la fila no llega al borde. */
  .mosaic > .card-wrap {
    position: relative;
    flex: calc(var(--ar) * 1000) 1 0;
    aspect-ratio: var(--ar);
    min-width: 0;
  }

  .corte {
    display: none;
    flex: 0 0 100%;
    height: 0;
  }
  @media (min-width: 801px) {
    .corte.ancho { display: block; }
  }
  @media (max-width: 800px) {
    .corte.angosto { display: block; }
    /* El tope de placas en pantalla angosta: los proyectos con muchos
       fotogramas dejaban un bloque larguísimo en el teléfono. */
    .solo-ancho { display: none; }
  }

  .card {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    height: 100%;
    padding: 0;
    background: var(--bg-2);
    text-align: left;
    transform: translateY(var(--lift, 0px));
    transition: transform .5s var(--ease), box-shadow .5s ease;
  }
  /* La foto la dibuja <Picture>, que es otro componente: de ahí los :global. */
  .card :global(picture) { display: block; width: 100%; height: 100%; }
  .card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .9s var(--ease), opacity .4s;
  }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (hover: hover) and (pointer: fine) {
    .card:hover { --lift: -6px; box-shadow: 0 22px 44px -28px rgba(36, 33, 28, .65); }
    .card:hover :global(img) { transform: scale(1.07); }
  }

</style>
