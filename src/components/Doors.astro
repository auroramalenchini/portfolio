---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SmallCaps from './SmallCaps.astro';
import { doors } from '../lib/doors';

// Las dos puertas de la portada: Video y Foto. La primera foto de cada una va
// en el html, con sus medidas y su srcset; las demás viajan dentro de un
// <template>, así el navegador no las descarga hasta que el script las usa.

/** Nunca pedimos más ancho del que tiene el archivo: agrandar no suma nitidez. */
function anchos(img: ImageMetadata): number[] {
  return [...new Set([800, 1600].map((w) => Math.min(w, img.width)))];
}

// Apiladas cada puerta ocupa el ancho entero; lado a lado, la mitad.
const SIZES = '(min-width: 801px) 50vw, 100vw';

// El cartel del recorte de video es la misma foto que abre la puerta, ya
// optimizada por el build.
const posters = new Map<string, string>();
for (const door of doors) {
  if (door.clip) {
    const poster = await getImage({ src: door.photos[0], width: 1600, format: 'jpeg' });
    posters.set(door.href, poster.src);
  }
}
---

<nav class="doors" aria-label="Elegí por dónde empezar">
  {
    doors.map((door) => (
      <a class="door" href={door.href}>
        {door.clip ? (
          <video
            class="door-media door-clip"
            poster={posters.get(door.href)}
            muted
            autoplay
            loop
            playsinline
            preload="auto"
            tabindex="-1"
            aria-hidden="true"
          >
            {door.clip.webm && <source src={door.clip.webm} type="video/webm" />}
            <source src={door.clip.mp4} type="video/mp4" />
          </video>
        ) : (
          <span class="door-media" data-rotar={door.photos.length > 1 ? '' : undefined}>
            <span class="door-capa">
              <Picture
                src={door.photos[0]}
                widths={anchos(door.photos[0])}
                sizes={SIZES}
                formats={['avif']}
                fallbackFormat="jpeg"
                loading="eager"
                alt=""
              />
            </span>
            {door.photos.length > 1 && (
              <template>
                {door.photos.slice(1).map((foto) => (
                  <span class="door-capa">
                    <Picture
                      src={foto}
                      widths={anchos(foto)}
                      sizes={SIZES}
                      formats={['avif']}
                      fallbackFormat="jpeg"
                      loading="eager"
                      alt=""
                    />
                  </span>
                ))}
              </template>
            )}
          </span>
        )}
        <span class="door-body">
          <span class="door-label">
            <SmallCaps text={door.label} />
          </span>
          <span class="door-sub">{door.sub}</span>
        </span>
      </a>
    ))
  }
</nav>

<style>
  /* ---------- Base: apiladas, una arriba de la otra ---------- */
  .doors {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
    padding: 0 var(--pad) var(--s-4);
  }

  .door {
    position: relative;
    display: block;
    overflow: hidden;
    height: var(--door-h);
    background: var(--bg-2);
  }
  .door:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }

  /* La foto y el video van absolutos y a sangre: así ninguno deja una franja
     abajo, y el fondo de la puerta es crema y no el negro del reproductor. */
  .door-media {
    position: absolute;
    inset: 0;
    background: var(--bg-2);
  }
  .door-capa {
    position: absolute;
    inset: 0;
    display: block;
    transition: opacity .7s ease;
  }
  /* Se va la que estaba: debajo ya está la siguiente, descargada. */
  .door-capa.se-va { opacity: 0; }

  /* Las fotos las genera <Picture>, que no lleva el atributo de alcance de
     este componente: por eso estos dos selectores son globales. */
  .door-capa :global(img),
  video.door-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    background: var(--bg-2);
    transform: scale(1.02);
    transition: transform 1.1s var(--ease);
  }
  video.door-media { pointer-events: none; }

  /* Apiladas el texto va al medio de la placa, como el nombre de arriba, y el
     velo tiene que ser parejo y no un degradado del piso. */
  .door::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28, 25, 20, .72), rgba(28, 25, 20, .42));
  }

  .door-body {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    text-align: center;
    color: var(--on-media);
    transition: transform .5s var(--ease);
  }
  .door-label {
    font-family: var(--font-display);
    font-weight: var(--peso-titulo);
    font-size: var(--t-door);
    line-height: 1;
  }
  .door-sub {
    font-size: var(--t-2);
    color: rgba(246, 241, 231, .82);
    max-width: 36ch;
  }

  /* ---------- Escritorio con mouse: lado a lado, detrás del nombre ----------
     La misma condición que usa Opening.astro para el escenario fijo. Si las
     dos no coincidieran, las puertas quedarían lado a lado sin el escenario
     que las enfoca, o al revés. Con el dedo, con poco ancho, sin animaciones
     de scroll o con movimiento reducido, manda el bloque de arriba. */
  @media (hover: hover) and (pointer: fine) and (min-width: 801px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .doors {
        position: absolute;
        inset: 0;
        grid-template-columns: 1fr 1fr;
        gap: var(--s-3);
        padding: 0;
        transition: grid-template-columns .7s var(--ease);
      }
      .door { height: 100%; }

      /* Ensanchar la puerta que mirás es cosa de mouse y de teclado, nunca del
         dedo: en táctil el toque movía el objetivo de abajo del dedo y el clic
         se perdía. De ahí que antes hubiera que tocar dos veces. */
      .doors:has(.door:first-child:hover),
      .doors:has(.door:first-child:focus-visible) { grid-template-columns: 1.28fr .72fr; }
      .doors:has(.door:last-child:hover),
      .doors:has(.door:last-child:focus-visible) { grid-template-columns: .72fr 1.28fr; }

      .door:hover .door-capa :global(img),
      .door:focus-visible .door-capa :global(img),
      .door:hover video.door-media { transform: scale(1.09); }
      .door:hover .door-body { transform: translateY(-6px); }

      /* A sangre, el texto se lee mejor apoyado en el piso de la foto. */
      .door::after {
        background: linear-gradient(to top, rgba(28, 25, 20, .8), rgba(28, 25, 20, .04) 60%);
      }
      .door-body {
        inset: auto 0 0 0;
        justify-content: flex-end;
      }
    }
  }
</style>

<script>
  // Las fotos de cada puerta se van pasando con un fundido, cada 5 segundos y
  // sólo mientras la puerta está a la vista y la pestaña activa. La siguiente
  // se mete detrás de la actual en cuanto termina un pase: cuando toca el
  // fundido ya está descargada y no se ve un hueco.
  const LAPSO = 5000;
  const FUNDIDO = 700;
  const reducido = matchMedia('(prefers-reduced-motion: reduce)');

  for (const media of document.querySelectorAll<HTMLElement>('.door-media[data-rotar]')) {
    const molde = media.querySelector('template');
    const primera = media.querySelector<HTMLElement>('.door-capa');
    if (!molde || !primera || reducido.matches) continue;

    // El ciclo termina volviendo a la primera, como en el sitio viejo.
    const ciclo = [
      ...(Array.from(molde.content.children) as HTMLElement[]),
      primera.cloneNode(true) as HTMLElement,
    ];
    if (ciclo.length < 2) continue;

    let actual = primera;
    let proxima: HTMLElement | null = null;
    let i = 0;
    let reloj: number | null = null;
    let aLaVista = false;

    function precargar() {
      if (proxima) return;
      const nodo = ciclo[i].cloneNode(true) as HTMLElement;
      i = (i + 1) % ciclo.length;
      media.insertBefore(nodo, media.firstChild);
      proxima = nodo;
    }

    function pasar() {
      if (!proxima) {
        precargar();
        return;
      }
      const saliente = actual;
      actual = proxima;
      proxima = null;
      saliente.classList.add('se-va');
      window.setTimeout(() => {
        saliente.remove();
        precargar();
      }, FUNDIDO);
    }

    function arrancar() {
      precargar();
      if (reloj === null) reloj = window.setInterval(pasar, LAPSO);
    }
    function parar() {
      if (reloj !== null) window.clearInterval(reloj);
      reloj = null;
    }
    function revisar() {
      if (aLaVista && !document.hidden) arrancar();
      else parar();
    }

    const mirando = new IntersectionObserver(
      (entradas) => {
        aLaVista = entradas.some((e) => e.isIntersecting);
        revisar();
      },
      { threshold: 0.05 }
    );
    mirando.observe(media.closest('.door') ?? media);
    document.addEventListener('visibilitychange', revisar);
  }
</script>
