---
// Un visor por página. Las tarjetas no lo conocen: basta con que lleven
// data-lb (el nombre del grupo) y los datos de la pieza, y el script las
// encuentra por delegación. Así sirve igual para fotos y para videos.
//
// Contrato de las tarjetas:
//   data-lb          nombre del grupo; las flechas se mueven sólo ahí adentro
//   data-lb-src      jpeg de 1600px  +  data-lb-w / data-lb-h
//   data-lb-youtube  id de 11 caracteres, en lugar de data-lb-src
//   data-lb-title    y  data-lb-sub   para el pie
---

<dialog class="lightbox" aria-label="Visor de contenido">
  <button class="lb-btn lb-close" type="button" aria-label="Cerrar">×</button>
  <button class="lb-btn lb-prev" type="button" aria-label="Anterior">‹</button>
  <button class="lb-btn lb-next" type="button" aria-label="Siguiente">›</button>
  <div class="stage"></div>
  <div class="caption">
    <span class="caption-text"><strong></strong><span class="caption-sub"></span></span>
    <span class="caption-count"></span>
  </div>
</dialog>

<style>
  /* El visor tapa la pantalla entera con crema casi opaca: la foto queda
     sobre el mismo papel que el resto del sitio y no sobre un fondo negro. */
  .lightbox:not([open]) { display: none; }
  .lightbox[open] {
    /* minmax(0,1fr): si no, la foto estira la fila y se sale de la pantalla */
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    border: 0;
    padding: var(--s-visor) var(--pad) var(--s-5);
    background: color-mix(in srgb, var(--bg) 98.5%, transparent);
    color: var(--fg);
    animation: lb-in .35s ease both;
  }
  /* El fondo nativo no se ve nunca: la crema la pinta el propio diálogo. */
  .lightbox::backdrop { background: transparent; }

  /* La fila necesita alto definido: si no, el "max-height: 100%" de la foto no
     tiene contra qué calcularse y la imagen sale a tamaño natural. */
  .stage {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    place-items: center;
    min-height: 0;
  }
  /* La foto y el marco los crea el script, así que no llevan la clase del
     componente: por eso van con :global. */
  .stage :global(img) {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    animation: lb-zoom .55s var(--ease) both;
  }
  .stage :global(.frame) {
    width: min(100%, calc((100vh - 9rem) * 16 / 9));
    aspect-ratio: 16 / 9;
    background: var(--fg);
    animation: lb-zoom .55s var(--ease) both;
  }
  .stage :global(.frame iframe) { width: 100%; height: 100%; border: 0; }

  .caption {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-4);
    color: var(--fg-muted);
    font-size: var(--t-2);
  }
  .caption strong { color: var(--fg); font-weight: 600; }

  /* z-index: la foto lleva una animación de entrada con transform, que le crea
     contexto de apilado, y en el html los botones van antes que el escenario: sin
     esto la imagen se pinta encima y tapa media flecha. */
  .lb-btn {
    position: absolute;
    z-index: 2;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    font-size: 1.6rem;
    color: var(--fg-muted);
    border-radius: 50%;
    transition: color .2s, background .2s;
  }
  /* Un grupo de una sola pieza no muestra flechas. El display de arriba le
     gana al display:none del atributo hidden, así que hay que decirlo. */
  .lb-btn[hidden] { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .lb-btn:hover { color: var(--on-media); background: var(--accent); }
  }
  .lb-close { top: var(--s-3); right: var(--s-3); }
  .lb-prev { left: var(--s-2); top: 50%; transform: translateY(-50%); }
  .lb-next { right: var(--s-2); top: 50%; transform: translateY(-50%); }

  /* Círculo oscuro con la flecha clara: el fondo del visor ya es crema, así que
     un botón crema se camufla contra él, y uno claro se pierde sobre la foto.
     Oscuro se lee sobre las dos cosas.
     Va por tipo de dispositivo y no por ancho: en una tablet la foto también
     llega hasta las flechas, pero la pantalla mide más de 800 y se quedaba con
     el botón sin fondo de la computadora. Con any-pointer: coarse entra
     cualquier pantalla táctil, y el que tiene mouse conserva el botón limpio. */
  @media (max-width: 800px), (any-pointer: coarse) {
    .lb-btn {
      background: color-mix(in srgb, var(--fg) 62%, transparent);
      color: var(--on-media);
      backdrop-filter: blur(4px);
    }
  }

  @keyframes lb-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes lb-zoom {
    from { opacity: 0; transform: scale(.96); }
    to { opacity: 1; transform: none; }
  }
  /* base.css apaga todas las animaciones y transiciones con
     prefers-reduced-motion, incluidas las de acá y las que el script escribe
     en línea para el deslizamiento. */
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');

  if (dialog) {
    const stage = dialog.querySelector('.stage') as HTMLElement;
    const capTitle = dialog.querySelector('.caption strong') as HTMLElement;
    const capSub = dialog.querySelector('.caption-sub') as HTMLElement;
    const capCount = dialog.querySelector('.caption-count') as HTMLElement;
    const btnClose = dialog.querySelector('.lb-close') as HTMLButtonElement;
    const btnPrev = dialog.querySelector('.lb-prev') as HTMLButtonElement;
    const btnNext = dialog.querySelector('.lb-next') as HTMLButtonElement;

    let group: HTMLElement[] = [];
    let index = -1;
    let opener: HTMLElement | null = null;

    function show(i: number) {
      const it = group[i];
      if (!it) return;
      index = i;
      const title = it.dataset.lbTitle ?? '';
      const sub = it.dataset.lbSub ?? '';
      stage.textContent = '';

      const youtube = it.dataset.lbYoutube;
      if (youtube) {
        const frame = document.createElement('div');
        frame.className = 'frame';
        const iframe = document.createElement('iframe');
        iframe.src =
          'https://www.youtube-nocookie.com/embed/' +
          encodeURIComponent(youtube) +
          '?autoplay=1&rel=0&playsinline=1';
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = title;
        frame.appendChild(iframe);
        stage.appendChild(frame);
      } else {
        const img = document.createElement('img');
        img.src = it.dataset.lbSrc ?? '';
        const w = Number(it.dataset.lbW);
        const h = Number(it.dataset.lbH);
        if (w > 0) img.width = w;
        if (h > 0) img.height = h;
        img.alt = title;
        stage.appendChild(img);
      }

      capTitle.textContent = title;
      capSub.textContent = sub ? ' · ' + sub : '';
      capCount.textContent = i + 1 + ' / ' + group.length;
    }

    function open(card: HTMLElement) {
      const name = card.dataset.lb ?? '';
      group = Array.from(document.querySelectorAll<HTMLElement>('[data-lb]')).filter(
        (el) => el.dataset.lb === name && !dialog!.contains(el)
      );
      const i = group.indexOf(card);
      if (i < 0) return;
      const solo = group.length < 2;
      btnPrev.hidden = solo;
      btnNext.hidden = solo;
      opener = card;
      if (!dialog!.open) {
        document.body.style.overflow = 'hidden';
        dialog!.showModal();
      }
      show(i);
    }

    function close() {
      if (dialog!.open) dialog!.close();
    }

    // Las flechas se mueven sólo dentro del mismo grupo: al llegar al final se
    // cierra el visor y volvés a la grilla, en vez de seguir con el proyecto
    // siguiente, que hacía parecer que era todo un mismo trabajo.
    function pasar(paso: number) {
      if (index < 0 || !group.length) return;
      const destino = index + paso;
      if (destino < 0 || destino >= group.length) {
        close();
        return;
      }
      show(destino);
    }

    dialog.addEventListener('close', () => {
      stage.textContent = ''; // corta la reproducción del video
      document.body.style.overflow = '';
      index = -1;
      group = [];
      // El diálogo nativo devuelve el foco a quien lo abrió, pero sólo si ese
      // elemento tenía el foco: al hacer clic, Safari no enfoca los botones, y
      // con el dedo tampoco. Lo devolvemos a mano y queda igual en todas.
      if (opener && opener.isConnected) opener.focus();
      opener = null;
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const card = target?.closest<HTMLElement>('[data-lb]');
      if (!card || dialog.contains(card)) return;
      e.preventDefault();
      open(card);
    });

    btnClose.addEventListener('click', close);
    btnPrev.addEventListener('click', () => pasar(-1));
    btnNext.addEventListener('click', () => pasar(1));

    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      // Escape lo cierra el diálogo nativo, sin JavaScript.
      if (e.key === 'ArrowLeft') pasar(-1);
      if (e.key === 'ArrowRight') pasar(1);
    });

    // Deslizar para pasar de una foto a otra. El toque que termina en el fondo
    // también dispara el click que cierra el visor, así que un deslizamiento
    // deja marca y ese click se descarta.
    let deslizo = false;
    dialog.addEventListener('click', (e) => {
      if (deslizo) {
        deslizo = false;
        return;
      }
      if (e.target === dialog || e.target === stage) close();
    });

    let x0: number | null = null;
    let y0 = 0;
    let t0 = 0;
    let arrastrando = false;

    // La foto acompaña al dedo. La animación de entrada fija transform con
    // fill "both", y una animación le gana al estilo en línea, así que hay que
    // apagarla antes de poder mover la pieza a mano.
    function mover(dx: number, suave: boolean) {
      const el = stage.firstElementChild as HTMLElement | null;
      if (!el) return;
      el.style.animation = 'none';
      el.style.transition = suave
        ? 'transform .28s cubic-bezier(.2,.7,.2,1), opacity .28s ease'
        : 'none';
      el.style.transform = 'translateX(' + dx + 'px)';
      el.style.opacity = String(Math.max(0.3, 1 - Math.abs(dx) / 420));
    }

    dialog.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches.length !== 1) {
          x0 = null;
          return;
        }
        x0 = e.touches[0]!.clientX;
        y0 = e.touches[0]!.clientY;
        t0 = Date.now();
        arrastrando = false;
      },
      { passive: true }
    );

    dialog.addEventListener(
      'touchmove',
      (e) => {
        if (x0 === null || e.touches.length !== 1) return;
        const dx = e.touches[0]!.clientX - x0;
        const dy = e.touches[0]!.clientY - y0;
        if (!arrastrando) {
          if (Math.abs(dx) < 10) return; // todavía no se sabe
          if (Math.abs(dx) < Math.abs(dy)) {
            x0 = null; // es vertical
            return;
          }
          arrastrando = true;
        }
        mover(dx, false);
      },
      { passive: true }
    );

    dialog.addEventListener(
      'touchcancel',
      () => {
        if (arrastrando) mover(0, true);
        x0 = null;
        arrastrando = false;
      },
      { passive: true }
    );

    dialog.addEventListener(
      'touchend',
      (e) => {
        if (x0 === null) return;
        const t = e.changedTouches[0]!;
        const dx = t.clientX - x0;
        const dy = t.clientY - y0;
        x0 = null;
        // Tiene que ser largo y más horizontal que vertical: si no, era un toque
        // para cerrar o un gesto vertical. El tope de tiempo es holgado a
        // propósito: un deslizamiento lento y deliberado sigue siendo válido, y
        // lo único que descarta es el dedo apoyado un rato largo.
        const vale =
          Math.abs(dx) >= 45 && Math.abs(dx) >= Math.abs(dy) * 1.4 && Date.now() - t0 <= 2000;
        if (!vale) {
          // No alcanzó: la foto vuelve a su lugar en vez de quedar corrida.
          if (arrastrando) mover(0, true);
          arrastrando = false;
          return;
        }
        deslizo = true;
        arrastrando = false;
        const paso = dx < 0 ? 1 : -1;
        const el = stage.firstElementChild as HTMLElement | null;
        if (!el) {
          pasar(paso);
          return;
        }
        // Termina de salir para el lado del dedo y recién ahí entra la siguiente.
        el.style.animation = 'none';
        el.style.transition = 'transform .2s ease-out, opacity .2s ease-out';
        el.style.transform =
          'translateX(' + (paso > 0 ? -stage.clientWidth : stage.clientWidth) + 'px)';
        el.style.opacity = '0';
        setTimeout(() => pasar(paso), 190);
      },
      { passive: true }
    );
  }
</script>
