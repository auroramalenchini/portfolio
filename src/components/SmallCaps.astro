---
// Versalitas hechas a mano, ahora en el build y no en el navegador.
// El navegador, cuando no encuentra versalitas en la tipografía, las inventa
// achicando la mayúscula: el trazo se afina y no pega con las mayúsculas de
// verdad. Acá las minúsculas se escriben en mayúscula más chica pero con más
// grosor (.vs en base.css), así las dos tienen el mismo espesor de línea.
interface Props {
  text: string;
}

const { text } = Astro.props;

const ESCAPES: Record<string, string> = {
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;',
};

function esc(s: string): string {
  return s.replace(/[&<>"']/g, (c) => ESCAPES[c] ?? c);
}

function versalitas(texto: string): string {
  let salida = '';
  let junta = '';
  const cerrar = () => {
    if (junta) {
      salida += '<span class="vs">' + esc(junta.toUpperCase()) + '</span>';
      junta = '';
    }
  };
  for (const ch of String(texto)) {
    const esMinuscula = ch.toLowerCase() === ch && ch.toUpperCase() !== ch;
    if (esMinuscula) junta += ch;
    else {
      cerrar();
      salida += esc(ch);
    }
  }
  cerrar();
  return salida;
}

const html = versalitas(text);
---

<Fragment set:html={html} />
