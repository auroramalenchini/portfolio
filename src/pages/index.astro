---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SmallCaps from '../components/SmallCaps.astro';
import Opening from '../components/Opening.astro';
import { site, whatsappHref, mailtoHref } from '../lib/site';
import { doors } from '../lib/doors';
import { ogImagePath } from '../lib/images';
import sobreMi from '../assets/about/sobre-mi.jpg';
import prt from '../assets/about/prt.jpg';

// El arroba sale de la url de Instagram, así el dato está escrito una sola vez.
const instagramHandle = '@' + site.instagram.replace(/\/+$/, '').split('/').pop();

// Las fotos de "Sobre mí" nunca pasan de media columna en la computadora ni de
// media pantalla en el teléfono.
const SIZES_ABOUT = '(min-width: 801px) 30vw, 46vw';

// Para compartir, la primera foto de la puerta de Foto.
const puertaFoto = doors.find((door) => door.href === '/foto/') ?? doors[0];
const ogImage = await ogImagePath(puertaFoto.photos[0]);
---

<Base
  title="Aurora Malenchini · Directora, fotógrafa y creativa"
  description="Videoclips, films y fotografía comercial para restaurantes, eventos y espacios. Buenos Aires."
  page="home"
  image={ogImage}
>
  <script is:inline>
    // Marca que hay JavaScript: sin esto la página se ve completa y quieta.
    document.documentElement.classList.add('js');
  </script>

  <Opening />

  <section class="about" id="about">
    <div class="about-fotos">
      <Picture
        src={sobreMi}
        widths={[480, 960]}
        sizes={SIZES_ABOUT}
        formats={['avif']}
        fallbackFormat="jpeg"
        loading="lazy"
        alt="Aurora Malenchini fotografiando"
        pictureAttributes={{ class: 'reveal' }}
      />
      <Picture
        src={prt}
        widths={[480, 960]}
        sizes={SIZES_ABOUT}
        formats={['avif']}
        fallbackFormat="jpeg"
        loading="lazy"
        alt="Aurora Malenchini filmando en la calle"
        pictureAttributes={{ class: 'reveal' }}
      />
    </div>
    <div>
      <h2 class="reveal"><SmallCaps text="Sobre mí" /></h2>
      <p class="reveal">
        Soy una cineasta, fotógrafa y creativa argentina de 22 años. Soy egresada de
        la Universidad del Cine; soy amante del arte y del contenido visual.
      </p>
      <p class="reveal">
        Trabajo de imaginar y realizar fotografía y video: cubro eventos y capturo
        momentos únicos, como también planifico, produzco, dirijo y edito videoclips.
        Creo en la potencia del arte, de la cámara, de la música y del contenido
        audiovisual.
      </p>
      <p class="reveal">
        En un mundo bombardeado por imágenes, creo indispensable detenerse a realizar
        cada fotografía y cada fotograma con pasión y con amor.
      </p>
    </div>
  </section>

  <section class="contact" id="contact">
    <h2 class="reveal"><SmallCaps text="Contactame" /></h2>
    <p class="contact-lead reveal">
      Para briefs, disponibilidad y tarifas, escribime por mail o WhatsApp.
    </p>
    <div class="contact-links reveal">
      <a class="contact-link" href={whatsappHref} target="_blank" rel="noopener">
        <span class="cl-label">WhatsApp</span>
        <span class="cl-value">{site.phone}</span>
      </a>
      <a class="contact-link" href={site.instagram} target="_blank" rel="noopener">
        <span class="cl-label">Instagram</span>
        <span class="cl-value">{instagramHandle}</span>
      </a>
      <a class="contact-link" href={mailtoHref}>
        <span class="cl-label">Mail</span>
        <span class="cl-value">{site.email}</span>
      </a>
    </div>
    <p class="contact-place reveal">{site.location}</p>
  </section>
</Base>

<script>
  import { iniciarReveal } from '../lib/reveal';
  iniciarReveal();
</script>

<style is:global>
  /* Global y no con alcance: .reveal también va en los <picture> que genera
     <Picture>, que no lleva el atributo de alcance de esta página. */
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal {
      opacity: 0;
      transform: scale(.955);
      transition: opacity .9s var(--ease), transform .9s var(--ease);
    }
    .js .reveal.in {
      opacity: 1;
      transform: none;
    }
  }
</style>

<style>
  /* ---------- Sobre mí ---------- */
  .about {
    display: grid;
    grid-template-columns: min(48%, 62vh) 1fr;
    gap: var(--s-6);
    align-items: center;
    /* Más angosta que el resto: así el texto llega hasta el borde de su
       columna y el margen de la derecha queda igual al de la izquierda. */
    padding: var(--s-8) var(--pad);
    max-width: min(var(--max), 1320px);
    margin: 0 auto;
    width: 100%;
    border-top: 1px solid var(--line);
  }

  /* Dos fotos horizontales, una arriba de la otra: juntas forman un cuadrado.
     El ancho se limita por altura de pantalla para que la sección siga
     entrando entera y el cuadrado siga siendo cuadrado. */
  .about-fotos {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--s-2);
    width: 100%;
    aspect-ratio: 1 / 1;
  }
  /* Los <picture> los genera <Picture>: sin el atributo de alcance de esta
     página, así que van globales. */
  .about-fotos :global(picture) {
    display: block;
    width: 78%;
    height: 100%;
    min-height: 0;   /* si no, la foto estira la fila */
  }
  .about-fotos :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--bg-2);
  }
  /* Escalonadas: la de arriba corrida a la izquierda, la de abajo a la derecha. */
  .about-fotos :global(picture:first-child) { justify-self: start; }
  .about-fotos :global(picture:last-child) { justify-self: end; }

  .about h2 {
    font-size: var(--t-5);
    line-height: 1.02;
    margin: 0 0 var(--s-4);
  }
  .about p {
    color: var(--fg-muted);
    font-family: var(--font-read);
    font-size: 1.1em;
    line-height: 1.62;
    /* Justificado, pero sin cortar palabras: la columna es ancha y no hacen
       falta. */
    text-align: justify;
    hyphens: none;
    margin: 0;
  }
  .about p + p { margin-top: var(--s-4); }

  /* ---------- Contacto ---------- */
  .contact {
    padding: var(--s-8) var(--pad);
    max-width: var(--max);
    margin: 0 auto;
    width: 100%;
    border-top: 1px solid var(--line);
    text-align: center;
  }
  .contact h2 {
    font-size: var(--t-contact);
    line-height: 1.02;
    margin: 0 0 var(--s-4);
  }
  .contact-lead {
    color: var(--fg-muted);
    margin: 0 auto;
    max-width: 42ch;
    font-family: var(--font-read);
    font-size: 1.1em;
    line-height: 1.62;
  }
  .contact-links {
    display: flex;
    flex-direction: column;
    margin: var(--s-6) auto 0;
    max-width: 27rem;
    width: 100%;
  }
  .contact-link {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-5) var(--s-3);
    border-bottom: 1px solid var(--line);
    transition: background .25s ease;
  }
  .contact-link:first-child { border-top: 1px solid var(--line); }
  .cl-label {
    font-size: var(--t-2);
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--fg-title);
    transition: color .25s ease;
  }
  .cl-value {
    font-size: var(--t-2);
    color: var(--fg-muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-link:hover { background: var(--bg-2); }
    .contact-link:hover .cl-label { color: var(--accent); }
  }
  .contact-place {
    margin: var(--s-5) auto 0;
    font-size: var(--t-1);
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  @media (max-width: 800px) {
    /* En vertical las dos fotos van en fila, del mismo tamaño y un poco
       recortadas. Escalonadas una arriba de la otra formaban un cuadrado del
       ancho de la pantalla y empujaban el texto casi una pantalla más abajo.
       En la computadora sigue el mosaico escalonado. */
    .about {
      grid-template-columns: 1fr;
      gap: var(--s-6);
      padding-top: var(--s-7);
    }
    /* Apaisadas y bien recortadas: con la caja alta el recorte era de unos
       pocos píxeles y las fotos se veían casi enteras, sin el acercamiento
       que tienen en la computadora. */
    .about-fotos {
      grid-template-rows: 1fr;
      grid-template-columns: 1fr 1fr;
      aspect-ratio: auto;
      height: var(--about-h);
    }
    .about-fotos :global(picture) { width: 100%; justify-self: stretch; }
    /* Ella y la cámara viven en la franja izquierda del cuadro: centrado al
       medio, el recorte le come la cara. */
    .about-fotos :global(picture:last-child img) { object-position: 32% center; }
  }
</style>
