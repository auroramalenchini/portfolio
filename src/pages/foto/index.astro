---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SmallCaps from '../../components/SmallCaps.astro';
import Mosaic from '../../components/Mosaic.astro';
import ProjectBlock from '../../components/ProjectBlock.astro';
import BackToTop from '../../components/BackToTop.astro';
import Lightbox from '../../components/Lightbox.astro';
import { ogImagePath, previewOf, projectImages } from '../../lib/images';
import { GRUPOS_FOTO, NOMBRES_GRUPO, etiquetaGrupos } from '../../lib/schemas';
import { site } from '../../lib/site';

// Un bloque por proyecto, en el orden que declara cada index.md. La vista de
// conjunto muestra la selección del proyecto (o las primeras seis) y el link
// a la página con todas.
const projects = (await getCollection('foto')).sort((a, b) => a.data.order - b.data.order);

// Para compartir, la primera foto del primer proyecto.
const ogImage = await ogImagePath(projectImages('foto', projects[0].id)[0].image);

// Los filtros. Uno sin proyectos no se muestra: llevaría a una página sin
// nada.
const filtros = GRUPOS_FOTO.map((grupo) => ({
  grupo,
  nombre: NOMBRES_GRUPO[grupo],
  cuantos: projects.filter((p) => p.data.grupos.includes(grupo)).length,
})).filter((f) => f.cuantos > 0);

const blocks = projects.map((project) => {
  const total = projectImages('foto', project.id).length;
  const etiqueta = etiquetaGrupos(project.data.grupos);
  const items = previewOf(project).map(({ image, n }) => ({
    image,
    alt: `${project.data.title} — foto ${n}`,
    lb: { group: project.id, title: project.data.title, sub: etiqueta },
  }));
  const { mobileLimit } = project.data;
  return {
    slug: project.id,
    data: project.data,
    total,
    etiqueta,
    items,
    // "Ver las N fotos" va siempre que la previa no las muestre todas. Si sólo
    // las esconde el tope del teléfono, el link es sólo del teléfono.
    verTodas: items.length < total ? 'siempre' : mobileLimit && mobileLimit < total ? 'angosto' : null,
  };
});
---

<Base
  title="Foto · Aurora Malenchini"
  description="Fotografía y video comercial para restaurantes, eventos y espacios."
  page="photo"
  image={ogImage}
>
  <section class="intro wrap">
    <h1><SmallCaps text="Foto" /></h1>
    <p>
      Fotografía social y producto: restaurantes, eventos, rodajes y espacios.
      También realizo video resumen o video reel, con edición y color.
    </p>
    <!-- Sin JavaScript los botones no harían nada: nacen escondidos y el
         script los muestra. Sin ellos se ve todo, como antes. -->
    <div
      class="filtros"
      role="group"
      aria-label="Filtrar trabajos"
      data-ordenes={JSON.stringify(site.fotoFiltros ?? {})}
      hidden
    >
      <button type="button" class="filtro" data-filtro="" aria-pressed="true">Todo</button>
      {
        filtros.map((f) => (
          <button type="button" class="filtro" data-filtro={f.grupo} aria-pressed="false">
            {f.nombre}
          </button>
        ))
      }
    </div>
  </section>

  <section class="projects wrap" aria-label="Trabajos de fotografía">
    {
      blocks.map((block, i) => (
        <ProjectBlock
          title={block.data.title}
          category={block.etiqueta}
          side={i % 2 ? 'right' : 'left'}
          grupos={block.data.grupos}
          slug={block.slug}
        >
          {block.verTodas && (
            <a
              slot="info"
              class:list={['see-all', { 'solo-angosto': block.verTodas === 'angosto' }]}
              href={`/foto/${block.slug}/`}
            >
              Ver las {block.total} fotos
            </a>
          )}
          <Mosaic
            items={block.items}
            layout="foto"
            sizes="(max-width: 800px) 60vw, 30vw"
            mobileLimit={block.data.mobileLimit}
          />
        </ProjectBlock>
      ))
    }
  </section>

  <BackToTop />

  <Lightbox />
</Base>

<script>
  // Los filtros: esconden los proyectos que no están en el grupo elegido (uno
  // puede estar en varios), los ponen en el orden propio del filtro si
  // site.json lo trae, y vuelven a alternar los lados entre los que quedan,
  // para que no queden dos títulos seguidos del mismo lado. El filtro elegido va en la dirección (#eventos), así un
  // link puede abrir la página ya filtrada.
  const caja = document.querySelector<HTMLElement>('.filtros');
  const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtro'));
  const proyectos = Array.from(document.querySelectorAll<HTMLElement>('.project[data-grupos]'));
  const validos = new Set(botones.map((b) => b.dataset.filtro));
  const ordenes: Record<string, string[]> = JSON.parse(caja?.dataset.ordenes ?? '{}');

  /** El orden de un filtro: primero los de su lista, después el resto en el
   *  orden general. Sin lista, el orden general. */
  function enOrden(grupo: string): HTMLElement[] {
    const lista = ordenes[grupo] ?? [];
    const puesto = (p: HTMLElement) => {
      const i = lista.indexOf(p.dataset.slug ?? '');
      return i === -1 ? lista.length : i;
    };
    // sort es estable: los que empatan conservan el orden general.
    return [...proyectos].sort((a, b) => puesto(a) - puesto(b));
  }

  function filtrar(grupo: string) {
    for (const b of botones) b.setAttribute('aria-pressed', String(b.dataset.filtro === grupo));
    // Se mueven en el documento y no sólo a la vista: así el teclado y los
    // lectores de pantalla los recorren en el mismo orden en que se ven.
    const ordenados = enOrden(grupo);
    ordenados[0]?.parentElement?.append(...ordenados);
    let i = 0;
    for (const p of ordenados) {
      const va = !grupo || (p.dataset.grupos ?? '').split(' ').includes(grupo);
      p.hidden = !va;
      if (va) p.classList.toggle('right', i++ % 2 === 1);
    }
  }

  if (caja) {
    caja.hidden = false;
    for (const b of botones) {
      b.addEventListener('click', () => {
        const grupo = b.dataset.filtro ?? '';
        filtrar(grupo);
        // replaceState y no location.hash: cambiar el hash saltaría al ancla.
        history.replaceState(null, '', grupo ? `#${grupo}` : location.pathname);
      });
    }
    const pedido = () => {
      const grupo = location.hash.slice(1);
      filtrar(validos.has(grupo) ? grupo : '');
    };
    if (location.hash) pedido();
    // Si se cambia a mano el #filtro de la dirección, con la página abierta.
    addEventListener('hashchange', pedido);
  }
</script>

<style>
  /* Los proyectos escondidos por un filtro. El [hidden] del navegador pierde
     contra el display: grid del bloque, y el espacio entre proyectos pasa a
     ser un gap: con el margen entre hermanos, el primero visible arrastraba
     el aire del escondido de arriba. */
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }
  .projects :global(.project + .project) { margin-top: 0; }
  .projects :global(.project[hidden]) { display: none; }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }
  .filtros[hidden] { display: none; }
  .filtro {
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-esquina);
    background: transparent;
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color .2s, border-color .2s, background-color .2s;
  }
  .filtro[aria-pressed="true"] {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--on-media);
  }
  .filtro:focus-visible { outline: 2px solid var(--fg-title); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .filtro[aria-pressed="false"]:hover { color: var(--fg); border-color: var(--fg); }
  }
  /* Los 44px del dedo, como en el menú. */
  @media (any-pointer: coarse) {
    .filtro { min-height: 44px; }
  }
  /* En el teléfono, con el aire de la compu, ocupaban tres renglones. */
  @media (max-width: 560px) {
    .filtro { padding-inline: var(--s-3); letter-spacing: .08em; }
  }

  /* El mismo corte que el tope de Mosaic.astro: en pantalla ancha se ven
     todas las fotos y el link sobra. */
  @media (min-width: 801px) {
    .solo-angosto { display: none; }
  }

  .intro { padding-block: var(--s-7) var(--s-5); }
  h1 { font-size: var(--t-page); line-height: .96; margin-bottom: var(--s-4); }
  .intro p {
    color: var(--fg-muted);
    font-family: var(--font-read);
    font-size: var(--t-4);
    line-height: 1.62;
    max-width: 52ch;
  }
  /* En el teléfono la bajada a cuerpo de lectura ocupaba media pantalla
     antes de la primera foto: va al tamaño del menú. */
  @media (max-width: 560px) {
    .intro p { font-size: var(--t-2); }
  }

  /* Un respiro entre la bajada de la página y el primer proyecto. */
  .projects { padding-block: var(--s-7) var(--s-8); }
</style>
