---
// Banco de pruebas del visor: tres grupos armados a mano para poder probarlo
// sin las páginas reales. Se borra cuando /foto/<slug>/ y /video/ existan.
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';

const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../content/foto/anantara/*.jpg',
  { eager: true }
);
const fuentes = Object.keys(archivos)
  .sort()
  .slice(0, 3)
  .map((ruta) => archivos[ruta]!.default);

// El visor muestra el jpeg de 1600px: lo pedimos acá para tener la URL final.
const fotos = await Promise.all(
  fuentes.map(async (src, i) => {
    const ancho = Math.min(1600, src.width);
    const grande = await getImage({ src, width: ancho, format: 'jpeg' });
    return {
      src,
      lbSrc: grande.src,
      w: ancho,
      h: Math.round((src.height * ancho) / src.width),
      title: `Anantara ${String(i + 1).padStart(2, '0')}`,
      sub: 'Hotel',
    };
  })
);

const sola = fotos[0]!;
---

<Base title="Lab del visor" description="Banco de pruebas del visor." page="lab">
  <section class="wrap lab">
    <h1>Lab del visor</h1>

    <h2>Grupo a: tres fotos</h2>
    <div class="tira">
      {
        fotos.map((f) => (
          <button
            type="button"
            class="card"
            data-lb="a"
            data-lb-src={f.lbSrc}
            data-lb-w={f.w}
            data-lb-h={f.h}
            data-lb-title={f.title}
            data-lb-sub={f.sub}
          >
            <Picture
              src={f.src}
              widths={[480, 960]}
              formats={['avif']}
              alt={f.title}
              sizes="(max-width: 700px) 90vw, 30vw"
            />
          </button>
        ))
      }
    </div>

    <h2>Grupo b: una sola foto</h2>
    <div class="tira">
      <button
        type="button"
        class="card"
        data-lb="b"
        data-lb-src={sola.lbSrc}
        data-lb-w={sola.w}
        data-lb-h={sola.h}
        data-lb-title="Anantara sola"
        data-lb-sub="Hotel"
      >
        <Picture
          src={sola.src}
          widths={[480, 960]}
          formats={['avif']}
          alt="Anantara sola"
          sizes="(max-width: 700px) 90vw, 30vw"
        />
      </button>
    </div>

    <h2>Grupo c: un video</h2>
    <button
      type="button"
      class="play"
      data-lb="c"
      data-lb-youtube="QOTH0P_PPqc"
      data-lb-title="Gusto a Sal"
      data-lb-sub="Maqui"
    >
      Ver el video
    </button>
  </section>
  <Lightbox />
</Base>

<style>
  .lab { padding-block: var(--s-6) var(--s-8); }
  h1 { font-size: var(--t-page); margin-bottom: var(--s-5); }
  h2 {
    font-size: var(--t-2);
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-block: var(--s-6) var(--s-3);
  }
  .tira { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .card { flex: 1 1 260px; min-width: 0; }
  .play {
    padding: var(--s-3) var(--s-5);
    background: var(--accent);
    color: var(--on-media);
    font-size: var(--t-2);
    letter-spacing: .13em;
    text-transform: uppercase;
  }
</style>
